# Copy to env.local — keys never leave this machine
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
SEA_LION_API_KEY=
AI_AUTO=1

# Cortex engine (REQUIRED for Hosting/Cortex CRM + Business safety)
# 1) Start engine in F:\Cortex or RUMA/Cortex:  START_ENGINE.bat
#    or: .\scripts\start_cortex_engine.ps1
# 2) AirGPT polls /health + /api/engine/* every 5s — do not run vendored CortexOS as the server
# https://github.com/Netie-AI/Cortex/tree/netie-engine-up
CORTEX_API_URL=http://127.0.0.1:8010
CORTEX_API_KEY=dms-demo-steward-key

# LTX-2 video (cloud and/or local) — see docs/VIDEO_LTX2_PLAN.md
# LTX_API_KEY=
# LTX_MODEL=ltx-2-3-fast
# LTX2_ROOT=F:/AirGPT/third_party/LTX-2
# LTX2 mock always works; cloud/local produce real mp4s

# Optional local inference (OpenAI-compatible). Soft-fails to BYOK cloud when offline.
# vLLM: https://github.com/vllm-project/vllm — high-throughput GPU serving
# VLLM_BASE_URL=http://127.0.0.1:8001
# VLLM_API_KEY=EMPTY
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional Colibri disk-streamed MoE sidecar (frontier MoE on ~25GB RAM; not default chat)
# https://github.com/JustVugg/colibri — see docs/local-inference.md
# COLIBRI_BASE_URL=http://127.0.0.1:8002
# COLIBRI_API_KEY=EMPTY
# COLIBRI_MODEL=colibri

# OpenVault mesh (this laptop: E:\OpenVault). Dual-home: pin OPENVAULT_HOME.
# OPENVAULT_ROOT=E:\OpenVault
# OPENVAULT_HOME=E:\OpenVault\.openvault
# OPENVAULT_URL=http://127.0.0.1:5000
# OPENIDE_URL=http://127.0.0.1:8766
# Cursor/Claude: paste in OpenVault Providers. Do not invent keys.
# CURSOR_API_KEY=
# ANTHROPIC_API_KEY=
# Laptop control: Cortex crew master switch. Mutating tools still Confirm.
# CORTEX_COMPUTER_CONTROL=1

# Optional Business license control plane
# AIRGPT_API_BASE=http://127.0.0.1:8787

# Resend (waitlist & security alerts → hello@netie.ai)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@netie.ai
RESEND_FROM_AUTH=no-reply@mail.netie.ai
RESEND_REPLY_TO=hello@netie.ai
CONTACT_TO=hello@netie.ai
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# NEXT UPDATE (not active): fully online Personal AI + pay-to-continue
# ONLINE_PERSONAL_AI=0

# Scaling flags (design only for Business; Local+ adapters soft-fail without deps)
# Default is always local SQLite; these only matter for opt-in profiles.
# AIRGPT_STORAGE=sqlite        # sqlite | postgres
# DATABASE_URL=                # postgresql://user:pass@host:5432/airgpt
# AIRGPT_CACHE=none            # none | redis
# REDIS_URL=                   # redis://host:6379/0  (semantic cache TTL for Local+)
# AIRGPT_VECTOR=auto           # auto | none | sqlite_vec | pgvector
# QDRANT_URL=                  # http://127.0.0.1:6333  (profile=local_qdrant)
# Optional pip: qdrant-client, redis — never required for personal/local RAG.

# GitHub OAuth Device Flow (Settings → Connect GitHub). Host-only.
# GITHUB_CLIENT_ID=            # OAuth App client id (device flow)
# Default scopes are minimal (read:user repo:status). Broad opt-in in UI.

# RAG dense embedder (optional). Default hash stays offline/EXE-safe.
# Set st|bge when sentence-transformers is installed; rebuild each space after switching.
# AIRGPT_RAG_EMBED=st          # hash | st | bge | off
# First st run may download BAAI/bge-small-en-v1.5 (~130MB) unless already cached.
