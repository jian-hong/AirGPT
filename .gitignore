# Local environment and credentials
env.local
openvault.local.json
.env
.env.*
!.env.example
!env.local.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Runtime data and user-provided content
data/
data-demo-mock/
drops/

# Live-host copies of research packages (served from /ui/ without clipdrop reload)
ui/exports/**
!ui/exports/.gitkeep

# Local editor and agent state
.claude/settings.local.json
.vscode/settings.json

# Python/runtime output
__pycache__/
*.py[cod]
*.log

# Downloaded binaries and heavyweight raw media
bin/cloudflared.exe
*.mov
*.mkv
*.avi
*.mxf
*.zip

# Keep the curated video-assets tree, scripts, docs, and small MP4/WebM samples.
# Finished masters should be distributed separately or through Git LFS.
video-assets/07-exports/*
!video-assets/07-exports/DROP_MASTERS_HERE.txt
video-assets/08-ltx2-outputs/*
!video-assets/08-ltx2-outputs/.gitkeep

# OpenFree vendored gateway (prebuilt npm, ~739MB) + runtime
vendor/openfree/node_modules/
data/openfree/

# Engine cross-mirror — Cortex lives in its OWN repo (D:\Cortex). Never nest it
# here (a mirror-of-a-mirror nested git repo breaks `git add`, and it carries a
# live env.local). Same for any Vertex mirror.
CortexOS/
Vertex/

# Personal / non-product material - not part of the AirGPT product tree
Interview Resources/

# Sample-messy fixtures (few hundred MB; generate locally)
tests/RAG/messy/


# Research checkouts - gitlinks removed (REPO-01 #3). Nothing in the product
# imports these; the findings are in OpenIDE/research/SCRAP_*.md. third_party/colibri
# STAYS a submodule - hosting.py:64 resolves it on disk.
OpenIDE/research/orca/
OpenIDE/research/superset/

# Vendor UI clones (~12GB, --depth 1, design study only). The verdicts worth keeping
# are in docs/research/vendor-ui-references.md. Re-clone if ever needed again.
vendor/dbgate/
vendor/outerbase-studio/
vendor/vendor/

# Heavyweight RAG fixture packs - generate locally, do not commit binaries
tests/RAG/FRTR-bench/
tests/RAG/primary50/
tests/RAG/t2-ragbench/

# Regenerated bench intermediates and runtime ops tokens - not artifacts
tests/RAG/frtr_sanitized/
tests/RAG/results/ops/

# Per-seed oracle bench runs - the harness regenerates them; keep only _latest
tests/RAG/results/oracle_bench_seed*.json

# Agent working copies (git worktrees). Never part of the repo.
.claude/worktrees/
